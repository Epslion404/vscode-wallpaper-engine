{
  "name": "vscode-wallpaper-engine",
  "displayName": "vscode-wallpaper-engine",
  "description": "",
  "publisher": "vakesamahere",
  "repository": {
    "type": "git",
    "url": "https://github.com/vakesamahere/vscode-wallpaper-engine.git"
  },
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-wallpaper-engine.refreshWallpaper",
        "title": "Refresh Wallpaper: 刷新壁纸"
      },
      {
        "command": "vscode-wallpaper-engine.setWallpaper",
        "title": "Set Wallpaper: 设置壁纸"
      },
      {
        "command": "vscode-wallpaper-engine.openInBrowser",
        "title": "Open Wallpaper in Browser: 在浏览器打开"
      },
      {
        "command": "vscode-wallpaper-engine.uninstallWallpaper",
        "title": "Restore Wallpaper Changes: 还原壁纸修改"
      },
      {
        "command": "vscode-wallpaper-engine.openSettings",
        "title": "Open Wallpaper Settings: 打开壁纸设置"
      }
    ],
    "configuration": {
      "title": "VSCode Wallpaper Engine",
      "properties": {
        "vscode-wallpaper-engine.workshopPath": {
          "type": "string",
          "default": "",
          "description": "Wallpaper Engine 创意工坊目录路径 (例如: D:/Steam/steamapps/workshop/content/431960)"
        },
        "vscode-wallpaper-engine.wallpaperEnginePath": {
          "type": "string",
          "default": "",
          "description": "Wallpaper Engine 可执行文件路径，留空时自动检测 / Wallpaper Engine executable path; auto-detected when empty"
        },
        "vscode-wallpaper-engine.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "FFmpeg 可执行文件路径，留空时自动检测 / FFmpeg executable path; auto-detected when empty"
        },
        "vscode-wallpaper-engine.backgroundOpacity": {
          "type": "number",
          "default": 0.1,
          "description": "代码编辑器的背景透明度 (0 - 1)"
        },
        "vscode-wallpaper-engine.serverPort": {
          "type": "number",
          "default": 23333,
          "description": "网页壁纸服务器端口"
        },
        "vscode-wallpaper-engine.wallpaperId": {
          "type": "string",
          "default": "",
          "description": "当前选中的壁纸 ID (文件夹名称)"
        },
        "vscode-wallpaper-engine.resizeDelay": {
          "type": "number",
          "default": 500,
          "description": "窗口大小改变后刷新壁纸的延迟时间 (毫秒)"
        },
        "vscode-wallpaper-engine.startupCheckInterval": {
          "type": "number",
          "default": 300,
          "description": "启动时检查壁纸服务器状态的间隔时间 (毫秒)"
        },
        "vscode-wallpaper-engine.customCss": {
          "type": "string",
          "default": "",
          "description": "自定义注入的 CSS 代码",
          "editPresentation": "multilineText"
        },
        "vscode-wallpaper-engine.themeCompatibility": {
          "type": "string",
          "enum": ["auto", "on", "off"],
          "default": "auto",
          "description": "C/C++ Theme 兼容模式 / C/C++ Theme compatibility mode (auto detects Visual Studio C/C++ themes)"
        },
        "vscode-wallpaper-engine.uiLanguage": {
          "type": "string",
          "enum": ["auto", "zh-CN", "en-US"],
          "default": "auto",
          "description": "Wallpaper Settings 界面语言 / Wallpaper Settings UI language"
        },
        "vscode-wallpaper-engine.transparencyEnabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用 UI 透明化"
        },
        "vscode-wallpaper-engine.transparencyBaseColor": {
          "type": "string",
          "default": "",
          "description": "透明化时的基底颜色 (Hex 格式, 例如 #1e1e1e)。留空则根据主题自动选择黑色或白色。"
        },
        "vscode-wallpaper-engine.transparencyRules": {
          "type": "object",
          "default": {
            "editor.background": 0,
            "surface.background": 0,
            "editorGroup.emptyBackground": 0,
            "editorGroupHeader.tabsBackground": 0,
            "sideBar.background": 0,
            "panel.background": 0,
            "terminal.background": 0
          },
          "description": "UI 元素透明度规则 (Key: UI Element, Value: Opacity 0-1)",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "build:scene-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-scene-capture-helper.ps1",
    "test": "vscode-test",
    "output": "npm run vsce-package && node ./scripts/move-vsix.js",
    "vsce-package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "sudo-prompt": "^9.2.1",
    "ws": "^8.21.3"
  }
}
